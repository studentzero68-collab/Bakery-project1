# Baker's Delight Backend Environment Variables
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file.

# MongoDB connection string
# Local:  mongodb://localhost:27017/bakers-delight
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/bakers-delight
MONGODB_URI=mongodb://localhost:27017/bakers-delight

# JWT secret — use a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret

# JWT expiry duration
JWT_EXPIRES_IN=7d

# Express port
PORT=5000

# Node environment
NODE_ENV=development

# Frontend URL for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# bcrypt salt rounds (10–12 is appropriate)
BCRYPT_SALT_ROUNDS=12

# MongoDB URI for tests (uses a separate database to avoid polluting dev data)
TEST_MONGODB_URI=mongodb://localhost:27017/bakers-delight-test
