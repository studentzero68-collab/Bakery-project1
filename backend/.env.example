# Baker's Delight — Backend Environment Variables
# Copy this file to .env and fill in your real values for local development.
# NEVER commit .env to GitHub — it is already listed in .gitignore.
#
# On Render (or any other host), add these as Environment Variables in the
# service dashboard instead of using a .env file.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL.
# Found at: Supabase dashboard → your project → Settings → API → Project URL
SUPABASE_URL=your_supabase_project_url

# Server-side only — NEVER expose this key to the browser or frontend code.
# Found at: Supabase dashboard → your project → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. Use a long, random string in production.
JWT_SECRET=your_jwt_secret_here

# ── Server ────────────────────────────────────────────────────────────────────
# Render injects PORT automatically — only set this for local dev if needed.
PORT=5000

# Set to "production" on Render.
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────
# The deployed URL of your frontend (e.g. your Render or Netlify URL).
# Used to allow cross-origin requests from the browser.
FRONTEND_URL=http://localhost:5173
