# Baker's Delight — Frontend Environment Variables
# For local development: copy this file to .env.local and fill in the values.
# For Render Static Site: add these as Environment Variables in the Render dashboard.
# NEVER commit .env.local to GitHub — it is already in .gitignore.

# ── Backend API ───────────────────────────────────────────────────────────────
# The full base URL of your deployed backend, including /api
# Local dev:  http://localhost:5000/api
# Production: https://your-backend-service.onrender.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api

# ── Supabase (public/browser-safe keys only) ──────────────────────────────────
# Found at: Supabase dashboard → your project → Settings → API
# Use the anon/publishable key — NEVER the service_role key here.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
